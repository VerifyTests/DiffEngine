<Solution>
  <Configurations>
    <BuildType Name="Debug" />
    <BuildType Name="Release" />
    <BuildType Name="Release-NotWindows" />
  </Configurations>
  <Folder Name="/Solution Items/">
    <File Path="../claude.md" />
    <File Path="../.github/workflows/test.yml" />
    <File Path="../.github/workflows/build-native.yml" />
    <File Path="../.github/workflows/publish-nuget.yml" />
    <File Path="../native/CMakeLists.txt" />
    <File Path="../readme.source.md" />
    <File Path="../.editorconfig" />
    <File Path="Directory.Build.props" />
    <File Path="Directory.Packages.props" />
    <File Path="../global.json" />
    <File Path="mdsnippets.json" />
  </Folder>
  <Project Path="DiffEngine.Tests/DiffEngine.Tests.csproj">
    <BuildDependency Project="FakeDiffTool/FakeDiffTool.csproj" />
    <BuildType Solution="Release-NotWindows|*" Project="Release" />
  </Project>
  <Project Path="DiffEngine/DiffEngine.csproj">
    <!--
    No BuildDependency on DiffEngineViewer. A solution level dependency is treated as a reference,
    so the viewer's content items and config files landed in DiffEngine's output for all eight
    target frameworks and flowed on into DiffEngineTray. Ordering is expressed as a reference in
    DiffEngine.csproj instead, where it can be told not to copy anything.
    -->
    <BuildType Solution="Release-NotWindows|*" Project="Release" />
  </Project>
  <Project Path="DiffEngine.Benchmarks/DiffEngine.Benchmarks.csproj">
    <BuildType Solution="Release-NotWindows|*" Project="Release" />
  </Project>
  <Project Path="DiffEngineViewer/DiffEngineViewer.csproj">
    <BuildType Solution="Release-NotWindows|*" Project="Release" />
  </Project>
  <Project Path="DiffEngineViewer.Tests/DiffEngineViewer.Tests.csproj">
    <BuildType Solution="Release-NotWindows|*" Project="Release" />
  </Project>
  <Project Path="Packaging.Tests/Packaging.Tests.csproj">
    <BuildType Solution="Release-NotWindows|*" Project="Release" />
    <!--
    Release-NotWindows drops DiffEngineTray, so its package would be missing and these baselines
    would not describe a full release. Same reason publish-nuget.yml runs on windows-latest.
    -->
    <Build Solution="Release-NotWindows|*" Project="false" />
  </Project>
  <Project Path="DiffEngineTray.Tests/DiffEngineTray.Tests.csproj">
    <BuildDependency Project="FakeDiffTool/FakeDiffTool.csproj" />
    <BuildType Solution="Release-NotWindows|*" Project="Release" />
    <Build Solution="Release-NotWindows|*" Project="false" />
  </Project>
  <Project Path="DiffEngineTray/DiffEngineTray.csproj">
    <BuildType Solution="Release-NotWindows|*" Project="Release" />
    <Build Solution="Release-NotWindows|*" Project="false" />
  </Project>
  <Project Path="FakeDiffTool/FakeDiffTool.csproj">
    <BuildType Solution="Release-NotWindows|*" Project="Release" />
    <!--
    A WinForms app targeting net10.0-windows, so it cannot build off Windows without
    EnableWindowsTargeting, and the result would not run there anyway. The tests that use it are
    marked [RunOn(OS.Windows)].
    -->
    <Build Solution="Release-NotWindows|*" Project="false" />
  </Project>
  <Project Path="DiffEngine.AotTests/DiffEngine.AotTests.csproj">
    <BuildType Solution="Release-NotWindows|*" Project="Release" />
  </Project>
</Solution>
