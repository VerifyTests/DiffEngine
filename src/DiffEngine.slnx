  <Project Path="DiffEngine.Tests/DiffEngine.Tests.csproj">
    <BuildDependency Project="FakeDiffTool/FakeDiffTool.csproj" />
    <BuildType Solution="Release-NotWindows|*" Project="Release" />
  </Project>
  <Project Path="DiffEngine/DiffEngine.csproj">
    <!--
    DiffEngine bundles the viewer into its package. Expressed here rather than as a
    ProjectReference, because a reference from this multi-targeted project would try to build the
    single TFM viewer once per DiffEngine target framework.
    -->
    <BuildDependency Project="DiffEngineViewer/DiffEngineViewer.csproj" />
    <BuildType Solution="Release-NotWindows|*" Project="Release" />
  </Project>
  <Project Path="DiffEngine.Benchmarks/DiffEngine.Benchmarks.csproj">
    <BuildType Solution="Release-NotWindows|*" Project="Release" />
  </Project>
  <Project Path="DiffEngineViewer/DiffEngineViewer.csproj">
    <BuildType Solution="Release-NotWindows|*" Project="Release" />
  </Project>
  <Project Path="DiffEngineViewer.Tests/DiffEngineViewer.Tests.csproj">
    <BuildType Solution="Release-NotWindows|*" Project="Release" />
  </Project>
  <Project Path="DiffEngineTray.Tests/DiffEngineTray.Tests.csproj">
    <BuildDependency Project="FakeDiffTool/FakeDiffTool.csproj" />
    <BuildType Solution="Release-NotWindows|*" Project="Release" />
    <Build Solution="Release-NotWindows|*" Project="false" />
  </Project>
  <Project Path="DiffEngineTray/DiffEngineTray.csproj">
    <BuildType Solution="Release-NotWindows|*" Project="Release" />
    <Build Solution="Release-NotWindows|*" Project="false" />
  </Project>
  <Project Path="FakeDiffTool/FakeDiffTool.csproj">
    <BuildType Solution="Release-NotWindows|*" Project="Release" />
