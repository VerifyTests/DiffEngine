<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!--
    The launcher resolves the executable by name, so every head produces DiffEngineViewer.exe. The
    package id is what differs, because a renderer cannot be chosen at load time the way a native
    library can.
    -->
    <AssemblyName>DiffEngineViewer</AssemblyName>
    <ToolCommandName>DiffEngineViewer</ToolCommandName>
    <PackageId>DiffEngineViewer.Linux</PackageId>
    <PackAsTool>true</PackAsTool>
    <Description>A diff tool for text files and inline snapshots, for Linux.</Description>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RollForward>LatestMajor</RollForward>
    <!--
    RuntimeIdentifiers is deliberately NOT set. Combined with PackAsTool it empties the
    tools/net10.0/any payload, and the per-RID publishes DiffEngine bundles do not need it: each
    one restores for its own single RID.
    -->
    <CreateRidSpecificToolPackages>false</CreateRidSpecificToolPackages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiffEngineViewer\DiffEngineViewer.csproj" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <None Include="..\DiffEngineViewer\Assets\JetBrainsMono-OFL.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
  Prebuilt by native/CMakeLists.txt and committed, so a plain dotnet build produces a shippable
  package on any machine and contributors never need CMake. Regenerated by build-native.yml.

  Not packed explicitly: CopyToOutputDirectory carries them into the publish output, which is what
  PackAsTool packages, so naming them again produces a duplicate file error.

  A RID-less build carries both architectures, so NativeResolver can pick at load time. A
  RID-specific publish carries only its own, which is what stops the copies DiffEngine bundles
  each dragging in the other.
  -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == ''">
    <None Include="runtimes\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
    <None Include="runtimes\$(RuntimeIdentifier)\**\*"
          CopyToOutputDirectory="PreserveNewest"
          Link="runtimes\$(RuntimeIdentifier)\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
