<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\DiffEngine.Tests\MachineSettings.cs" Link="MachineSettings.cs" />
    <Using Include="DiffEngine" />
    <PackageReference Include="Argon" />
    <PackageReference Include="Verify.TUnit" />
    <PackageReference Include="SimpleInfoName" />
    <PackageReference Include="Verify" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <ProjectReference Include="..\DiffEngineViewer\DiffEngineViewer.csproj" />
    <!--
    Aliased. DiffEngineViewer links DiffEngine's Inline sources rather than referencing them, so
    both assemblies declare a DiffEngine namespace. The alias keeps unqualified names resolving to
    the viewer's copies, while ViewerProtocolTests can still reach the engine's half of the wire
    format to prove the two agree.
    -->
    <ProjectReference Include="..\DiffEngine\DiffEngine.csproj" Aliases="engine" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />

  <!--
  The native renderers belong to the platform heads, but NativeTests and PixelTests exercise them
  through the core, so this project needs whichever one matches the RID it is running on. Taking
  all of them keeps that a single rule rather than three conditions.
  -->
    <None Include="..\DiffEngineViewer.Linux\runtimes\**\*;..\DiffEngineViewer.Mac\runtimes\**\*;..\DiffEngineViewer.Windows\runtimes\**\*"
          CopyToOutputDirectory="PreserveNewest"
          Link="runtimes\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Office files for the real renderer. PDFs are built by SamplePdf, so a test controls each page. -->
    <None Include="DocumentSamples\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
  The documents folder with every RID's natives, since this runs on all three platforms in CI.
  Present beside the tests, so DocumentPlugin.Find is exercised the way a viewer runs it; nothing in
  the viewer picks it up unless handed it, which is why the rest of these tests are unaffected.
  -->
  <Import Project="..\DiffEngineViewer.Documents\Documents.targets" />
</Project>
