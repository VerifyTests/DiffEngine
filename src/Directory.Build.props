<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Version>20.8.1</Version>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <PackageTags>Testing, Snapshot, Diff, Compare</PackageTags>
    <Description>Launches diff tools based on file extensions. Designed to be consumed by snapshot testing libraries.</Description>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <SignAssembly>true</SignAssembly>
    <ContinuousIntegrationBuild>false</ContinuousIntegrationBuild>
    <AssemblyOriginatorKeyFile>..\key.snk</AssemblyOriginatorKeyFile>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <ResolveAssemblyReferencesSilent>true</ResolveAssemblyReferencesSilent>
    <!--
    One NoWarn, because a second property of the same name replaces the first rather than adding to
    it. There were two, so CS0649, NU1608 and NU1109 were not suppressed at all - and with
    TreatWarningsAsErrors below they would have failed a build rather than warned in one.
    -->
    <NoWarn>CS1591;CS0649;NU1608;NU1109;CA1416</NoWarn>
    <!-- Polyfill's types are marked as embedded, which hides them from the assemblies named in
         InternalsVisibleTo. A project that needs them references Polyfill itself. -->
    <PolyUseEmbeddedAttribute>true</PolyUseEmbeddedAttribute>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-08</Verify_SponsorshipExemptionUntil>
    <!-- Morph, behind DiffEngineViewer.Documents, runs the same check. Renewed with the pair above. -->
    <Papyrine_SponsorshipExemption>OpenSource</Papyrine_SponsorshipExemption>
    <Papyrine_SponsorshipExemptionUntil>2027-08</Papyrine_SponsorshipExemptionUntil>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.Runtime.CompilerServices" />
    <Using Include="System.Runtime.InteropServices" />
    <Using Include="System.Collections" />
    <Using Include="System.Collections.Concurrent" />
    <Using Include="System.Diagnostics" />
    <Using Include="System.Reflection" />
  </ItemGroup>
  <!--
  The kernel PlatformHeads.Core shares with BuildMonitor, for the viewer and every project that
  sees its core. Its types are generic over a state and a screen, and these name them for the
  viewer's. The tray's tests see the core too, under an alias, so they take the namespace alone.
  -->
  <ItemGroup Condition="$(MSBuildProjectName.StartsWith('DiffEngineViewer')) and '$(MSBuildProjectName)' != 'DiffEngineViewer.Documents'">
    <Using Include="PlatformHeads" />
    <Using Include="PlatformHeads.SessionHost&lt;SessionState&gt;" Alias="SessionHost" />
    <Using Include="PlatformHeads.ScreenCache&lt;SessionState, Screen&gt;" Alias="ScreenCache" />
    <Using Include="PlatformHeads.OpenWindow&lt;IViewerWindow&gt;" Alias="OpenWindow" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DiffEngineTray.Tests'">
    <Using Include="PlatformHeads" />
  </ItemGroup>
</Project>
