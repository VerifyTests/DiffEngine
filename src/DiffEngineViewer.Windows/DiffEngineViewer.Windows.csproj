<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!--
    The whole package is Windows only, so this could target net10.0-windows. It does not, because
    PackAsTool then produces a platform locked package rather than tools/net10.0/any. Same trick
    DiffEngineTray uses: claim the Windows platform only for the check that would refuse
    UseWindowsForms on a platform neutral framework, then put it back.
    -->
    <NoWarn>$(NoWarn);NETSDK1137</NoWarn>
    <!--
    So the Linux and macOS CI jobs can still publish the win-x64 and win-arm64 heads that
    DiffEngine bundles. They only have to build there, never run.
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!--
    The launcher resolves the executable by name, so every head produces DiffEngineViewer.exe. The
    package id is what differs, because a renderer cannot be chosen at load time the way a native
    library can.
    -->
    <AssemblyName>DiffEngineViewer</AssemblyName>
    <ToolCommandName>DiffEngineViewer</ToolCommandName>
    <PackageId>DiffEngineViewer.Windows</PackageId>
    <PackAsTool>true</PackAsTool>
    <Description>A diff tool for text files and inline snapshots, for Windows.</Description>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RollForward>LatestMajor</RollForward>
    <CreateRidSpecificToolPackages>false</CreateRidSpecificToolPackages>
  </PropertyGroup>

  <Target Name="RemoveTargetPlatformIdentifier" BeforeTargets="_CheckForInvalidWindowsDesktopTargetingConfiguration">
    <PropertyGroup>
      <TargetPlatformIdentifier>Windows</TargetPlatformIdentifier>
    </PropertyGroup>
  </Target>
  <Target Name="RestoreTargetPlatformIdentifier" AfterTargets="_CheckForInvalidWindowsDesktopTargetingConfiguration">
    <PropertyGroup>
      <TargetPlatformIdentifier></TargetPlatformIdentifier>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <Using Include="System.ComponentModel" />
    <Using Include="System.Drawing" />
    <Using Include="System.Drawing.Drawing2D" />
    <Using Include="System.Drawing.Imaging" />
    <Using Include="System.Drawing.Text" />
    <Using Include="System.Windows.Forms" />
    <!--
    The Screen model has a Button, and so does WinForms. Types in the global namespace win over
    ones a using brings in, so unqualified Button is the model's and the control needs a name.
    -->
    <Using Include="System.Windows.Forms.Button" Alias="FormsButton" />
    <ProjectReference Include="..\DiffEngineViewer\DiffEngineViewer.csproj" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <None Include="..\DiffEngineViewer\Assets\JetBrainsMono-OFL.txt" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
