<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <!-- The .NET Framework legs, which only Windows can build -->
    <TargetFrameworks Condition=" '$(OS)' == 'Windows_NT'">net462;net472;net48;$(TargetFrameworks)</TargetFrameworks>
    <AllowUnsafeBlocks Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">true</AllowUnsafeBlocks>
    <!-- DiffEngineTray, the benchmarks and the tests use internals through InternalsVisibleTo.
         DiffEngine's own are all in this namespace and are kept whole. What Polyfill adds is hidden
         from them (PolyUseEmbeddedAttribute), so it is trimmed where nothing here uses it. -->
    <Squash_InternalNamespacesToKeep>DiffEngine</Squash_InternalNamespacesToKeep>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="DiffEngine" />
    <Using Include="System.Text" />
    <Using Include="Microsoft.Win32.SafeHandles" />
    <Using Include="System.Diagnostics.CodeAnalysis" />
    <Using Include="System.Net" />
    <Using Include="System.Net.Sockets" />
    <Using Include="EmptyFiles" />
    <Using Include="System.ReadOnlySpan&lt;System.Char&gt;" Alias="CharSpan" />
    <PackageReference Include="Sbom" PrivateAssets="all" />
    <PackageReference Include="System.Runtime.InteropServices.RuntimeInformation"
                      Condition="'$(TargetFramework)' == 'net462' OR '$(TargetFramework)' == 'net472'" />
    <PackageReference Include="EmptyFiles" PrivateAssets="None" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <PackageReference Include="Squash" PrivateAssets="all" />
    <None Include="buildTransitive\DiffEngine.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

  <!--
  Ordering only. PlatformHeadsPublish shells out to dotnet publish for the viewer, so without this
  a solution build can have two processes building that project at once.

  Every piece of metadata here is load bearing: the viewer is an Exe whose output carries six
  native renderers as content, and all of it would otherwise be copied into DiffEngine's output,
  then on into DiffEngineTray, whose PackAsTool payload is its entire publish directory. That is
  what a solution level BuildDependency used to do, silently.

  Restricted to one target framework because the viewer only has one, and DiffEngine has eight.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="..\DiffEngineViewer.Windows\DiffEngineViewer.Windows.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      ExcludeAssets="all" />
    <ProjectReference Include="..\DiffEngineViewer.Mac\DiffEngineViewer.Mac.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      ExcludeAssets="all" />
    <ProjectReference Include="..\DiffEngineViewer.Linux\DiffEngineViewer.Linux.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      ExcludeAssets="all" />
  </ItemGroup>

  <!--
  Bundles DiffEngineViewer so inline snapshots work out of the box, with no second install, by
  PlatformHeads' targets: one framework dependent publish per RID, which gives a real apphost
  per platform and avoids having to resolve the dotnet host at launch, staged and then packed.
  The managed payload is a few hundred KB, so repeating it six times costs almost nothing next
  to the natives that dominate either way. They were this project's own targets, and
  BuildMonitor's own beside them, each a copy of the other.

  Whenever the project is packed, with no property to turn it off. This used to hang off
  GeneratePackageOnBuild, so any pack path that did not have it set produced a package with no
  viewer in it and reported nothing wrong. 20.0.0-beta.37 shipped that way, at a third of the
  size, and every consumer of it without a globally installed tool got "`DiffEngine_ToolOrder`
  is configured to use 'DiffEngineViewer' but it is not installed" rather than a viewer.
  -->
  <PropertyGroup>
    <!--
    Where the heads are staged. Named here and not left to PlatformHeads' own choice, because
    DiffEngineTray takes the two Windows heads from it for its own package.
    -->
    <PlatformHeadsStageDir>$(MSBuildProjectDirectory)\obj\viewer\</PlatformHeadsStageDir>
    <PlatformHeadsPackagePath>tools\viewer</PlatformHeadsPackagePath>
  </PropertyGroup>

  <!--
  Each RID names the head that renders on it. Every head produces a DiffEngineViewer apphost, so
  tools/viewer keeps one shape and BundledViewerDirectory does not know any of this happened.

  Native says a head's renderer is a library committed under its runtimes folder, and one that
  is missing for a RID is warned of as PH0001. It is not set for Windows, because WinForms is the
  renderer there, which is the whole reason that head exists.
  -->
  <ItemGroup>
    <PackageReference Include="PlatformHeads" PrivateAssets="all" />
    <PlatformHead Include="win-x64" Project="..\DiffEngineViewer.Windows\DiffEngineViewer.Windows.csproj" Apphost="DiffEngineViewer.exe" />
    <PlatformHead Include="win-arm64" Project="..\DiffEngineViewer.Windows\DiffEngineViewer.Windows.csproj" Apphost="DiffEngineViewer.exe" />
    <PlatformHead Include="linux-x64" Project="..\DiffEngineViewer.Linux\DiffEngineViewer.Linux.csproj" Apphost="DiffEngineViewer" Native="true" />
    <PlatformHead Include="linux-arm64" Project="..\DiffEngineViewer.Linux\DiffEngineViewer.Linux.csproj" Apphost="DiffEngineViewer" Native="true" />
    <PlatformHead Include="osx-x64" Project="..\DiffEngineViewer.Mac\DiffEngineViewer.Mac.csproj" Apphost="DiffEngineViewer" Native="true" />
    <PlatformHead Include="osx-arm64" Project="..\DiffEngineViewer.Mac\DiffEngineViewer.Mac.csproj" Apphost="DiffEngineViewer" Native="true" />
  </ItemGroup>
</Project>
