<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks Condition=" '$(OS)' == 'Windows_NT'">net462;net472;net48;net9.0;net10.0</TargetFrameworks>
    <TargetFrameworks>$(TargetFrameworks);net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <AllowUnsafeBlocks Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">true</AllowUnsafeBlocks>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="DiffEngine" />
    <Using Include="System.Text" />
    <Using Include="Microsoft.Win32.SafeHandles" />
    <Using Include="System.Diagnostics.CodeAnalysis" />
    <Using Include="System.Net" />
    <Using Include="System.Net.Sockets" />
    <Using Include="EmptyFiles" />
    <Using Include="System.ReadOnlySpan&lt;System.Char&gt;" Alias="CharSpan" />
    <PackageReference Include="Microsoft.Sbom.Targets" PrivateAssets="all" Condition="'$(CI)' == 'true'" />
    <PackageReference Include="System.Runtime.InteropServices.RuntimeInformation"
                      Condition="'$(TargetFramework)' == 'net462' OR '$(TargetFramework)' == 'net472'" />
    <PackageReference Include="EmptyFiles" PrivateAssets="None" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <None Include="buildTransitive\DiffEngine.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

  <!--
  Ordering only. PublishViewerHeads shells out to dotnet publish for the viewer, so without this
  a solution build can have two processes building that project at once.

  Every piece of metadata here is load bearing: the viewer is an Exe whose output carries six
  native renderers as content, and all of it would otherwise be copied into DiffEngine's output,
  then on into DiffEngineTray, whose PackAsTool payload is its entire publish directory. That is
  what a solution level BuildDependency used to do, silently.

  Restricted to one target framework because the viewer only has one, and DiffEngine has eight.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="..\DiffEngineViewer\DiffEngineViewer.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      ExcludeAssets="all" />
  </ItemGroup>

  <!--
  Bundles DiffEngineViewer so inline snapshots work out of the box, with no second install.

  One framework dependent publish per RID, which gives a real apphost per platform and avoids
  having to resolve the dotnet host at launch. The managed payload is a few hundred KB, so
  repeating it six times costs almost nothing next to the natives that dominate either way.
  -->
  <PropertyGroup>
    <!-- Absolute: PublishDir is handed to the viewer project, where a relative path would
         resolve against its own directory rather than this one. -->
    <ViewerStageDir>$(MSBuildProjectDirectory)\obj\viewer\</ViewerStageDir>
    <BundleViewer Condition="'$(BundleViewer)' == '' And '$(GeneratePackageOnBuild)' == 'true'">true</BundleViewer>
    <GenerateNuspecDependsOn Condition="'$(BundleViewer)' == 'true'">AddViewerToPackage;$(GenerateNuspecDependsOn)</GenerateNuspecDependsOn>
  </PropertyGroup>

  <ItemGroup>
    <ViewerRid Include="win-x64" />
    <ViewerRid Include="win-arm64" />
    <ViewerRid Include="linux-x64" />
    <ViewerRid Include="linux-arm64" />
    <ViewerRid Include="osx-x64" />
    <ViewerRid Include="osx-arm64" />
  </ItemGroup>

  <Target Name="PublishViewerHeads" Condition="'$(BundleViewer)' == 'true'">
    <RemoveDir Directories="$(ViewerStageDir)" />
    <Warning Condition="!Exists('$(MSBuildThisFileDirectory)..\DiffEngineViewer\runtimes\%(ViewerRid.Identity)\native')"
             Code="DE0001"
             Text="No native renderer for %(ViewerRid.Identity). The package will not work on that platform. Run the build-native workflow." />
    <!--
    A separate process per RID rather than the MSBuild task. Each publish needs its own restore,
    and Restore plus Publish in one MSBuild task invocation do not see each other's results
    because the evaluated project is cached. Declaring RuntimeIdentifiers on the viewer instead
    would avoid the restores, but combined with PackAsTool it empties the tools/net10.0/any
    payload of the viewer's own standalone package.

    GeneratePackageOnBuild is switched off for these. ProjectDefaults turns it on for every Release
    project, so otherwise each per-RID publish would also pack the viewer and the last one would
    leave behind a RID-specific tool package.
    -->
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\DiffEngineViewer\DiffEngineViewer.csproj&quot; --configuration $(Configuration) --runtime %(ViewerRid.Identity) --self-contained false --output &quot;$(ViewerStageDir)%(ViewerRid.Identity)&quot; -p:GeneratePackageOnBuild=false"
          StandardOutputImportance="low" />
  </Target>

  <Target Name="AddViewerToPackage"
          DependsOnTargets="PublishViewerHeads"
          Condition="'$(BundleViewer)' == 'true'">
    <ItemGroup>
      <_ViewerFile Include="$(ViewerStageDir)**\*" />
      <!--
      TFM agnostic package files rather than TargetsForTfmSpecificContentInPackage: DiffEngine
      multi-targets eight frameworks, and the per-TFM hook would add this payload eight times.
      -->
      <!--
      Just the root. NuGet appends each file's path relative to the wildcard, so repeating
      RecursiveDir here doubles it, and naming the file explicitly breaks the extensionless Linux
      and macOS apphosts, which NuGet then reads as a folder.
      -->
      <_PackageFiles Include="@(_ViewerFile)"
                     BuildAction="None"
                     PackagePath="tools\viewer" />
    </ItemGroup>
  </Target>
</Project>
