<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Argon" Version="0.38.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="EmptyFiles" Version="8.20.1" />
    <PackageVersion Include="GeoConvert" Version="2.1.0" />
    <PackageVersion Include="MarkdownSnippets.MsBuild" Version="28.5.0" />
    <PackageVersion Include="Morph" Version="1.21.0" />
    <PackageVersion Include="Morph.PDFium" Version="1.4.0" />
    <PackageVersion Include="Morph.Skia" Version="1.21.0" />
    <!--
    Pinned with its Linux natives, which DiffEngineViewer.Documents references directly: SkiaSharp
    refuses a native library from another version, and the managed half arrives transitively
    through Morph.Skia, so without this the two could drift apart.
    -->
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageVersion Include="Polyfill" Version="11.4.3" />
    <PackageVersion Include="ProjectDefaults" Version="1.0.184" />
    <PackageVersion Include="Squash" Version="2.1.0" />
    <PackageVersion Include="Sbom" Version="0.3.1" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="System.Runtime.InteropServices.RuntimeInformation" Version="4.3.0" />
    <PackageVersion Include="Verify.WinForms" Version="6.0.0" />
    <PackageVersion Include="Verify.TUnit" Version="33.3.3" />
    <PackageVersion Include="SimpleInfoName" Version="3.2.1" />
    <PackageVersion Include="Verify" Version="33.3.2" />
    <PackageVersion Include="TUnit" Version="1.73.19" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>
</Project>