<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
    The renderer independent half of the viewer, referenced by each platform head. Named .Core
    because every head takes the plain DiffEngineViewer assembly name: the launcher looks the
    executable up by that name, so the apphost has to be DiffEngineViewer.exe wherever it came
    from.
    -->
    <AssemblyName>DiffEngineViewer.Core</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
    Linked rather than referenced. DiffEngine publishes and embeds the heads, so a
    ProjectReference back to DiffEngine would be a cycle. These files depend on nothing
    else in DiffEngine.
    -->
    <Compile Include="..\DiffEngine\Inline\*.cs" LinkBase="Inline" />
    <Compile Include="..\DiffEngine\Tray\TrayDetector.cs" LinkBase="Tray" />
    <Using Include="DiffEngine" />
    <PackageReference Include="DiffPlex" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\JetBrainsMono-Regular.ttf" LogicalName="DiffEngineViewer.JetBrainsMono-Regular.ttf" />
  </ItemGroup>
</Project>
