<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackAsTool>true</PackAsTool>
    <Description>A cross platform diff tool for text files and inline snapshots.</Description>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RollForward>LatestMajor</RollForward>
    <!--
    Stay framework dependent and platform agnostic: one tools/net10.0/any package carrying every
    RID under runtimes/, resolved at load time by NativeResolver. PackageId and ToolCommandName
    are deliberately unset so both default from the assembly name, matching DiffEngineTray.

    RuntimeIdentifiers is deliberately NOT set. Combined with PackAsTool it empties the
    tools/net10.0/any payload, and the per-RID publishes DiffEngine bundles do not need it: each
    one restores for its own single RID.
    -->
    <CreateRidSpecificToolPackages>false</CreateRidSpecificToolPackages>
  </PropertyGroup>

  <ItemGroup>
    <!--
    Linked rather than referenced. DiffEngine publishes and embeds this project, so a
    ProjectReference back to DiffEngine would be a cycle. These files depend on nothing
    else in DiffEngine.
    -->
    <Compile Include="..\DiffEngine\Inline\*.cs" LinkBase="Inline" />
    <Compile Include="..\DiffEngine\Tray\TrayDetector.cs" LinkBase="Tray" />
    <Using Include="DiffEngine" />
    <PackageReference Include="DiffPlex" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\JetBrainsMono-Regular.ttf" LogicalName="DiffEngineViewer.JetBrainsMono-Regular.ttf" />
    <None Include="Assets\JetBrainsMono-OFL.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
  Prebuilt by native/CMakeLists.txt and committed, so a plain dotnet build produces a shippable
  package on any machine and contributors never need CMake. Regenerated by build-native.yml.

  Not packed explicitly: CopyToOutputDirectory carries them into the publish output, which is what
  PackAsTool packages, so naming them again produces a duplicate file error.

  A RID-less build carries every RID, so NativeResolver can pick at load time and the RID agnostic
  tool package works anywhere. A RID-specific publish carries only its own, which is what stops
  the six copies DiffEngine bundles each dragging in all six sets of natives.
  -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == ''">
    <None Include="runtimes\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
    <None Include="runtimes\$(RuntimeIdentifier)\**\*"
          CopyToOutputDirectory="PreserveNewest"
          Link="runtimes\$(RuntimeIdentifier)\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
