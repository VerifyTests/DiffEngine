<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <NoWarn>$(NoWarn);CA1416;NU1902</NoWarn>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\DiffEngine.Tests\MachineSettings.cs" Link="MachineSettings.cs" />
    <!-- The helpers the core's tests and these share, which live with the core's tests. -->
    <Compile Include="..\DiffEngineTray.Core.Tests\FakeLauncher.cs" Link="Shared\FakeLauncher.cs" />
    <Compile Include="..\DiffEngineTray.Core.Tests\FakeViewer.cs" Link="Shared\FakeViewer.cs" />
    <Compile Include="..\DiffEngineTray.Core.Tests\FileLockUtils.cs" Link="Shared\FileLockUtils.cs" />
    <Compile Include="..\DiffEngineTray.Core.Tests\HeldApply.cs" Link="Shared\HeldApply.cs" />
    <Compile Include="..\DiffEngineTray.Core.Tests\RecordingTracker.cs" Link="Shared\RecordingTracker.cs" />
    <Compile Include="..\DiffEngineTray.Core.Tests\SilentOwner.cs" Link="Shared\SilentOwner.cs" />
    <Compile Include="..\DiffEngineTray.Core.Tests\StubInlineHost.cs" Link="Shared\StubInlineHost.cs" />
    <Compile Include="..\DiffEngineTray.Core.Tests\TrackedFilesExtensions.cs" Link="Shared\TrackedFilesExtensions.cs" />
    <Using Include="DiffEngine" />
    <PackageReference Include="Argon" />
    <PackageReference Include="Verify.WinForms" />
    <PackageReference Include="Verify.TUnit" />
    <PackageReference Include="EmptyFiles" />
    <PackageReference Include="SimpleInfoName" />
    <PackageReference Include="Verify" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <ProjectReference Include="..\DiffEngineTray\DiffEngineTray.csproj" />
    <ProjectReference Include="..\DiffEngine\DiffEngine.csproj" />
    <!--
    Aliased. DiffEngineViewer links DiffEngine's Inline and Protocol sources rather than referencing
    them, so both assemblies declare a DiffEngine namespace. Everything here except
    TrayViewerSyncTest wants the engine's copies, so the viewer is the one behind the alias.
    -->
    <ProjectReference Include="..\DiffEngineViewer\DiffEngineViewer.csproj" Aliases="viewer" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>
</Project>
