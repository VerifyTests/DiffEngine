<Project Sdk="Microsoft.NET.Sdk">

  <!--
  Everything the tray does that is not WinForms: the tracked moves and deletes, the inline queue it
  owns or drives, the piper port, the settings and the debug report. Built and tested on every
  platform, so a head for macOS and Linux can be put on it. FileLockKiller calls the restart
  manager, which compiles anywhere and runs only on Windows: Unix locks are advisory, so there is
  nothing for it to do elsewhere.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- For MacTray's session end, which the macOS library calls back through a function pointer -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="DiffEngine" />
    <Using Include="PlatformHeads" />
    <PackageReference Include="PlatformHeads.Core" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <ProjectReference Include="..\DiffEngine\DiffEngine.csproj" />
    <!-- The Windows head's pictures, under the names it embeds them by, for the heads with no WinForms. -->
    <EmbeddedResource Include="..\DiffEngineTray.Windows\Images\*.ico;..\DiffEngineTray.Windows\Images\*.png"
                      LinkBase="Images"
                      LogicalName="DiffEngineTray.Images.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
